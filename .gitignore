# Python bytecode / unoptimized code
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Database files — local SQLite DB should not be committed
# (Vercel uses /tmp at runtime; seed data is re-generated on cold start)
*.db
*.sqlite3

# Log files and temporary runtime files
*.log
flask_err.txt
flask_out.txt

# Environment variables
.env

# IDE and Editor folders
.vscode/
.idea/
.kiro/

# OS generated files
.DS_Store
Thumbs.db
